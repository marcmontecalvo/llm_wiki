# LLM Wiki — Environment Variable Defaults
# Copy to .env and adjust values for your deployment.

# UI authentication (used by both Web UI and TUI)
WIKI_UI_USER=admin
WIKI_UI_PASSWORD=wikitest2026

# Host port mapping (container always listens on 3050 internally)
WIKI_PORT=3050

# External wiki data volume path (absolute path, no tilde expansion)
WIKI_VOLUME=./wiki_system

WIKI_WEBUI_ENABLED=true
WIKI_TUI_ENABLED=true
