# LLM Wiki — Environment Variable Defaults
# Copy to .env and adjust values for your deployment.

# UI authentication (used by both Web UI and TUI)
WIKI_UI_USER=admin
# WIKI_UI_PASSWORD is auto-generated at container startup.
# To override, set this variable explicitly.

# Host port mapping (container always listens on 3050 internally)
WIKI_PORT=3050

# External wiki data volume path (absolute path)
WIKI_VOLUME=./wiki_system

# Feature flags (override daemon.yaml features block)
WIKI_WEBUI_ENABLED=false
WIKI_TUI_ENABLED=false
